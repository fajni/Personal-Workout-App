<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.FoodAddFragment"

    android:background="@android:color/transparent"

    android:paddingHorizontal="0pt">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:paddingBottom="40pt"
        android:paddingHorizontal="2pt"

        android:background="@color/dark_green"

        android:orientation="horizontal"
        >

    <ImageButton
        android:id="@+id/btnCloseAddFood"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:paddingHorizontal="15sp"
        android:paddingVertical="5sp"

        android:src="@drawable/close"
        android:background="@android:color/transparent"

        android:layout_weight="1"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_gravity="center"

        android:layout_marginStart="20sp"

        android:text="Add new nutrients/macros"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textAlignment="textStart"

        android:layout_weight="1"
        />

    </LinearLayout>

    <View
        android:layout_width="120pt"
        android:layout_height="70pt"

        android:layout_marginTop="15pt"

        android:background="@drawable/border_green"
        android:layout_gravity="center_horizontal"
        />

    <ImageView
        android:id="@+id/addMealImageView"

        android:layout_marginTop="15pt"

        android:layout_width="100pt"
        android:layout_height="70pt"

        android:src="@drawable/add_meal"

        android:layout_gravity="center_horizontal"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="90pt"
        android:paddingHorizontal="2pt"

        android:orientation="vertical"
        >

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:background="@drawable/table_border"

            android:paddingHorizontal="10sp"

            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Title:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="1.2"
                />

            <EditText
                android:id="@+id/addTitle"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter title"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="text"

                android:layout_weight="1"
                />

            <EditText
                android:id="@+id/addTitleValue"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="(g/ml)"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="number"

                android:layout_weight="1"
                />

        </LinearLayout>

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:background="@drawable/table_border"

            android:paddingHorizontal="10sp"
            android:layout_marginTop="5sp"

            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Calories:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="3"
                />

            <EditText
                android:id="@+id/addCaloriesValue"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter calories"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="number"

                android:layout_weight="1"
                />

        </LinearLayout>

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:background="@drawable/table_border"

            android:paddingHorizontal="10sp"
            android:layout_marginTop="5sp"

            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Proteins:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="3"
                />

            <EditText
                android:id="@+id/addProteinsValue"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter proteins"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="number"

                android:layout_weight="1"
                />

        </LinearLayout>

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:background="@drawable/table_border"

            android:paddingHorizontal="10sp"
            android:layout_marginTop="5sp"

            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Carbs:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="3"
                />

            <EditText
                android:id="@+id/addCarbsValue"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter carbs"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="number"

                android:layout_weight="1"
                />

        </LinearLayout>

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:background="@drawable/table_border"

            android:paddingHorizontal="10sp"
            android:layout_marginTop="5sp"

            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Fats:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="3"
                />

            <EditText
                android:id="@+id/addFatsValue"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter fats"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="number"

                android:layout_weight="1"
                />

        </LinearLayout>

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:background="@drawable/table_border"

            android:paddingHorizontal="10sp"
            android:layout_marginTop="5sp"

            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Fibers:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="3"
                />

            <EditText
                android:id="@+id/addFiberValue"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter fibers"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="number"

                android:layout_weight="1"
                />

        </LinearLayout>

    </LinearLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/submit"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginBottom="10sp"
        android:paddingHorizontal="40sp"

        app:cornerRadius="10sp"

        android:layout_gravity="bottom|center"

        android:text="SUBMIT"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textSize="15sp"

        android:backgroundTint="@color/dark_green"
        />

</FrameLayout>