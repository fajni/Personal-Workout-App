<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.FoodUpdateFragment"

    android:paddingHorizontal="0pt">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:paddingHorizontal="2pt"
        android:paddingBottom="40pt"

        android:background="@color/teal_700"

        android:orientation="horizontal"
        >

        <ImageButton
            android:id="@+id/btnCloseUpdateFood"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_weight="1"
            android:background="@android:color/transparent"

            android:layout_gravity="center"

            android:paddingHorizontal="20sp"
            android:paddingVertical="5sp"

            android:src="@drawable/close" />

        <TextView
            android:id="@+id/infoMealTitle"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_gravity="center"

            android:layout_marginStart="15sp"

            android:layout_weight="2"

            android:text="Food Info"
            android:textAlignment="textStart"
            android:textColor="@color/white"
            android:textSize="20sp"

            android:textStyle="bold" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="30pt"
        android:layout_marginHorizontal="5pt"

        app:cardBackgroundColor="@color/discord_color2"

        app:cardElevation="5dp"
        app:cardCornerRadius="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:paddingEnd="10sp"

            android:paddingVertical="5sp"
            >

        <ImageView

            android:id="@+id/mealImageView"

            android:layout_width="45pt"
            android:layout_height="50pt"

            android:src="@drawable/food"

            android:layout_marginHorizontal="5sp"

            android:background="@android:color/transparent"

            android:layout_gravity="start|center"

            android:layout_weight="1"

            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_weight="100"

            android:layout_marginLeft="10sp"

            android:layout_gravity="center"

            android:orientation="vertical"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"
                >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_weight="3"

                    android:text="Title: "
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    />

                <EditText
                    android:id="@+id/updateFoodTitle"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:hint="Enter new title"
                    android:textColorHint="@color/white"

                    android:textColor="@color/white"
                    android:textSize="18sp"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"
                >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_weight="3"

                    android:text="Date: "
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    />

                <EditText
                    android:id="@+id/updateFoodDate"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:hint="dd/mm/yyyy"
                    android:textColorHint="@color/white"

                    android:textColor="@color/white"
                    android:textSize="18sp"

                    android:inputType="date"
                    android:maxLength="10"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"
                >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_weight="3"

                    android:text="Time: "
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    />

                <EditText
                    android:id="@+id/updateFoodTime"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:hint="hh:mm"
                    android:textColorHint="@color/white"

                    android:textColor="@color/white"
                    android:textSize="18sp"

                    android:maxLength="10"
                    />

            </LinearLayout>

        </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="100pt"

        android:paddingHorizontal="5sp"

        android:orientation="vertical"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_weight="3"

                android:text="Calories: "
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                />

            <EditText
                android:id="@+id/updateFoodCalories"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:hint="Enter new calories"
                android:textColorHint="@color/white"

                android:textColor="@color/white"
                android:textSize="18sp"

                android:inputType="number"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_weight="3"

                android:text="Proteins: "
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                />

            <EditText
                android:id="@+id/updateFoodProteins"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:hint="Enter new proteins"
                android:textColorHint="@color/white"

                android:textColor="@color/white"
                android:textSize="18sp"

                android:inputType="number"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_weight="3"

                android:text="Carbs: "
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                />

            <EditText
                android:id="@+id/updateFoodCarbs"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:hint="Enter new carbs"
                android:textColorHint="@color/white"

                android:textColor="@color/white"
                android:textSize="18sp"

                android:inputType="number"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_weight="3"

                android:text="Fats: "
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                />

            <EditText
                android:id="@+id/updateFoodFats"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:hint="Enter new fats"
                android:textColorHint="@color/white"

                android:textColor="@color/white"
                android:textSize="18sp"

                android:inputType="number"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_weight="3"

                android:text="Fibers: "
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                />

            <EditText
                android:id="@+id/updateFoodFiber"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:hint="Enter new fibers"
                android:textColorHint="@color/white"

                android:textColor="@color/white"
                android:textSize="18sp"

                android:inputType="number"
                />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/updateFoodBtn"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="15sp"
            android:layout_marginHorizontal="5sp"
            android:paddingEnd="33dp"

            app:cornerRadius="10sp"

            android:layout_gravity="bottom|center"

            app:icon="@drawable/update_pen"
            app:iconTint="@color/white"
            app:iconGravity="start"
            app:iconSize="20sp"

            android:text="UPDATE"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textAlignment="center"

            android:backgroundTint="@color/teal_700"
            />

    </LinearLayout>

</FrameLayout>