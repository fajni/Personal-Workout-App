<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/discord_background_color"

    android:padding="2pt"

    tools:context=".fragments.MealInfoFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnMealInfoClose"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_weight="1"
            android:background="@android:color/transparent"

            android:paddingHorizontal="15sp"
            android:paddingVertical="5sp"

            android:src="@drawable/close" />

        <TextView
            android:id="@+id/infoMealTitle"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_gravity="center"

            android:layout_marginStart="20sp"

            android:layout_weight="1"
            android:text="Meal Info"
            android:textAlignment="textStart"
            android:textColor="@color/white"
            android:textSize="20sp"

            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="30pt"

        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_weight="2"

                android:text="Name: "
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/infoMealName"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:hint="Enter new title"
                android:textColor="@color/white"

                android:textColorHint="@color/white"
                android:textSize="18sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_weight="2"

                android:text="Texture: "
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/infoMealTexture"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:popupBackground="@color/discord_color3"

                tools:listitem="@layout/item_dropdown" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_weight="2"
                android:text="Ingredients: "
                android:textColor="@color/white"
                android:textSize="18sp"

                android:textStyle="bold" />

            <EditText
                android:id="@+id/infoMealIngredients"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_weight="1"
                android:hint="Enter new ingredients"
                android:inputType="text"

                android:textColor="@color/white"

                android:textColorHint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Description: "
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="2"
                />

            <EditText
                android:id="@+id/infoMealDesc"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter new description"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="text"

                android:layout_weight="1"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:layout_marginTop="30sp"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Calories (kcal): "
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="2"
                />

            <EditText
                android:id="@+id/infoMealCalories"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter new calories"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="number"

                android:layout_weight="1"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Proteins (g): "
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="2"
                />

            <EditText
                android:id="@+id/infoMealProteins"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter new proteins"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="number"

                android:layout_weight="1"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Carbs (g): "
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="2"
                />

            <EditText
                android:id="@+id/infoMealCarbs"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter new carbs"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="number"

                android:layout_weight="1"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Fats (g): "
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="2"
                />

            <EditText
                android:id="@+id/infoMealFats"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter new fats"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="number"

                android:layout_weight="1"
                />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:paddingHorizontal="10sp"
        android:paddingVertical="2sp"

        android:paddingEnd="40pt"

        android:layout_marginBottom="10sp"
        android:layout_gravity="bottom|center_horizontal"

        android:orientation="horizontal"
        >

        <Button
            android:id="@+id/btnMealInfoDelete"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:text="DELETE"
            android:textStyle="bold"
            android:textColor="@color/white"

            android:layout_marginEnd="5sp"

            android:backgroundTint="@color/red"
            />

        <Button
            android:id="@+id/btnMealInfoUpdate"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:text="UPDATE"
            android:textStyle="bold"
            android:textColor="@color/white"

            android:layout_marginStart="5sp"

            android:backgroundTint="@color/discord_blue"
            />

    </LinearLayout>

</FrameLayout>