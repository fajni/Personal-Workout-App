<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.MealAddFragment"

    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:paddingBottom="40pt"
        android:paddingHorizontal="2pt"

        android:background="@color/dark_green"

        android:orientation="horizontal"
        >

        <ImageButton
            android:id="@+id/btnCloseAddMeal"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:paddingHorizontal="15sp"
            android:paddingVertical="5sp"

            android:src="@drawable/close"
            android:background="@android:color/transparent"

            android:layout_weight="1"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_gravity="center"

            android:layout_marginStart="20sp"

            android:text="Add new meal"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textAlignment="textStart"

            android:layout_weight="1"
            />

    </LinearLayout>

    <View
        android:layout_width="120pt"
        android:layout_height="70pt"

        android:layout_marginTop="15pt"

        android:background="@drawable/border_green"
        android:layout_gravity="center_horizontal"
        />

    <ImageView
        android:id="@+id/addMealImageView"

        android:layout_marginTop="15pt"

        android:layout_width="100pt"
        android:layout_height="70pt"

        android:src="@drawable/add_meal"

        android:layout_gravity="center_horizontal"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="90pt"
        android:paddingHorizontal="2pt"
        >
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginBottom="5sp"
            android:paddingHorizontal="5pt"

            android:background="@drawable/table_border"

            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Name: "
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="2"
                />

            <EditText
                android:id="@+id/addMealName"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter name"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="text"

                android:layout_weight="1"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:layout_marginBottom="5sp"
            android:paddingHorizontal="5pt"

            android:background="@drawable/table_border"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Texture: "
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_gravity="center"

                android:layout_weight="2.2"
                />

            <Spinner
                android:id="@+id/addMealTexture"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                tools:listitem="@layout/item_dropdown"

                android:popupBackground="@color/discord_color3"

                android:layout_weight="1"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:layout_marginBottom="5sp"
            android:paddingHorizontal="5pt"

            android:background="@drawable/table_border"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Ingredients: "
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="2"
                />

            <EditText
                android:id="@+id/addMealIngredients"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter ingredients"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="textMultiLine"
                android:lines="4"
                android:maxLines="10"
                android:scrollbars="vertical"

                android:layout_weight="1"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:layout_marginBottom="5sp"
            android:paddingHorizontal="5pt"

            android:background="@drawable/table_border"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Description: "
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="2"
                />

            <EditText
                android:id="@+id/addMealDesc"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter description"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="text"

                android:layout_weight="1"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:layout_marginTop="30sp"

            android:layout_marginBottom="5sp"
            android:paddingHorizontal="5pt"

            android:background="@drawable/table_border"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Calories: "
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="2"
                />

            <EditText
                android:id="@+id/addMealCalories"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter calories"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="number"

                android:layout_weight="1"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:layout_marginBottom="5sp"
            android:paddingHorizontal="5pt"

            android:background="@drawable/table_border"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Proteins: "
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="2"
                />

            <EditText
                android:id="@+id/addMealProteins"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter proteins"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="number"

                android:layout_weight="1"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:layout_marginBottom="5sp"
            android:paddingHorizontal="5pt"

            android:background="@drawable/table_border"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Carbs: "
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="2"
                />

            <EditText
                android:id="@+id/addMealCarbs"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter carbs"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="number"

                android:layout_weight="1"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:layout_marginBottom="5sp"
            android:paddingHorizontal="5pt"

            android:background="@drawable/table_border"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Fats: "
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"

                android:layout_weight="2"
                />

            <EditText
                android:id="@+id/addMealFats"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Enter fats"
                android:textColorHint="@color/white"
                android:textColor="@color/white"

                android:inputType="number"

                android:layout_weight="1"
                />

        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMealSubmit"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginBottom="10sp"

        android:layout_gravity="bottom|center"

        app:cornerRadius="10dp"

        android:backgroundTint="@color/dark_green"

        android:text="SUBMIT"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textSize="15sp"
        />

</FrameLayout>