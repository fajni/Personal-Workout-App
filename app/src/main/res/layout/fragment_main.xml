<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:paddingHorizontal="5sp"

    tools:context=".fragments.MainFragment">

    <!-- Slide Image -->
    <ImageView
        android:id="@+id/slideInImage"

        android:layout_width="50dp"
        android:layout_height="50dp"

        android:layout_marginBottom="30pt"
        android:layout_marginRight="3pt"

        android:src="@drawable/arrow_down"
        app:tint="@color/dark_green"

        android:layout_gravity="end|bottom"
        android:visibility="invisible"
        />

    <LinearLayout
        android:id="@+id/noAccountValuesText"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="90dp"

        android:orientation="vertical"

        android:visibility="invisible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Please Add Account Data!"
            android:textAlignment="center"
            android:textColor="@color/discord_blue"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="You can add account values on acc button"
            android:textAlignment="center"
            android:textColor="@color/discord_color3"
            android:textSize="15sp"
            android:textStyle="normal" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/noValuesText"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="180dp"

        android:orientation="vertical"

        android:visibility="invisible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="No Values Yet!"
            android:textAlignment="center"
            android:textColor="@color/discord_blue"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="You can add new values on button below"
            android:textAlignment="center"
            android:textColor="@color/discord_color3"
            android:textSize="15sp"
            android:textStyle="normal" />

    </LinearLayout>

    <TextView
        android:id="@+id/checkYourMacrosText"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginHorizontal="10dp"

        android:text="Check your macros"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:textAlignment="center"
        />

    <ScrollView
        android:id="@+id/foodValues"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="30dp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginHorizontal="0dp"
            android:layout_marginTop="10dp"

            android:paddingVertical="5dp"

            android:orientation="vertical"
            >

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="@color/discord_color1"

                android:layout_marginBottom="10dp"

                app:cardCornerRadius="10dp"
                app:cardElevation="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:paddingHorizontal="10dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginBottom="10dp"
                        android:text="CALORIES"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="18sp"

                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressBarCalories"

                        style="?android:progressBarStyleHorizontal"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_gravity="center"

                        android:layout_weight="1"

                        android:progressDrawable="@drawable/progressbar" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_gravity="center_vertical"

                        android:layout_weight="100"

                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginHorizontal="5dp"

                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_weight="2"
                                android:text="Consumed: "
                                android:textColor="@color/white"

                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/caloriesConsumed"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"
                                android:text="VALUE"
                                android:textAlignment="textEnd"
                                android:textColor="@color/white"

                                android:textSize="18sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginHorizontal="5dp"

                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_weight="2"
                                android:text="Left: "
                                android:textColor="@color/white"

                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/caloriesLeft"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"
                                android:text="VALUE"
                                android:textAlignment="textEnd"
                                android:textColor="@color/white"

                                android:textSize="18sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="@color/discord_color1"

                android:layout_marginBottom="10dp"

                app:cardCornerRadius="10dp"
                app:cardElevation="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:paddingHorizontal="10dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginBottom="10dp"
                        android:text="PROTEINS"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="18sp"

                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressBarProteins"

                        style="?android:progressBarStyleHorizontal"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_gravity="center"

                        android:layout_weight="1"

                        android:progressDrawable="@drawable/progressbar" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_gravity="center_vertical"

                        android:layout_weight="100"

                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginHorizontal="5dp"

                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_weight="2"
                                android:text="Consumed: "
                                android:textColor="@color/white"

                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/proteinsConsumed"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"
                                android:text="VALUE"
                                android:textAlignment="textEnd"
                                android:textColor="@color/white"

                                android:textSize="18sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginHorizontal="5dp"

                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_weight="2"
                                android:text="Left: "
                                android:textColor="@color/white"

                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/proteinsLeft"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"
                                android:text="VALUE"
                                android:textAlignment="textEnd"
                                android:textColor="@color/white"

                                android:textSize="18sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="@color/discord_color1"

                android:layout_marginBottom="10dp"

                app:cardCornerRadius="10dp"
                app:cardElevation="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:paddingHorizontal="10dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginBottom="10dp"
                        android:text="CARBS"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="18sp"

                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressBarCarbs"

                        style="?android:progressBarStyleHorizontal"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_gravity="center"

                        android:layout_weight="1"

                        android:progressDrawable="@drawable/progressbar" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_gravity="center_vertical"

                        android:layout_weight="100"

                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginHorizontal="5dp"

                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_weight="2"
                                android:text="Consumed: "
                                android:textColor="@color/white"

                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/carbsConsumed"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"
                                android:text="VALUE"
                                android:textAlignment="textEnd"
                                android:textColor="@color/white"

                                android:textSize="18sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginHorizontal="5dp"

                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_weight="2"
                                android:text="Left: "
                                android:textColor="@color/white"

                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/carbsLeft"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"
                                android:text="VALUE"
                                android:textAlignment="textEnd"
                                android:textColor="@color/white"

                                android:textSize="18sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="@color/discord_color1"

                android:layout_marginBottom="10dp"

                app:cardCornerRadius="10dp"
                app:cardElevation="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:paddingHorizontal="10dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginBottom="10dp"
                        android:text="FATS"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="18sp"

                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressBarFats"

                        style="?android:progressBarStyleHorizontal"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_gravity="center"

                        android:layout_weight="1"

                        android:progressDrawable="@drawable/progressbar" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_gravity="center_vertical"

                        android:layout_weight="100"

                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginHorizontal="5dp"

                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_weight="2"
                                android:text="Consumed: "
                                android:textColor="@color/white"

                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/fatsConsumed"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"
                                android:text="VALUE"
                                android:textAlignment="textEnd"
                                android:textColor="@color/white"

                                android:textSize="18sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginHorizontal="5dp"

                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_weight="2"
                                android:text="Left: "
                                android:textColor="@color/white"

                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/fatsLeft"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"
                                android:text="VALUE"
                                android:textAlignment="textEnd"
                                android:textColor="@color/white"

                                android:textSize="18sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/todayWorkoutValues"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_gravity="bottom"

                android:orientation="vertical"

                android:visibility="visible">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal">

                    <TextView

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"
                        android:text="Today's Training: "
                        android:textColor="@color/white"
                        android:textSize="20sp"

                        android:textStyle="bold" />

                    <TextView

                        android:id="@+id/todayTrainingTitle"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"
                        android:text="title"
                        android:textColor="@color/white"

                        android:textSize="20sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal">

                    <TextView

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"
                        android:text="Muscle Part: "
                        android:textColor="@color/white"
                        android:textSize="20sp"

                        android:textStyle="bold" />

                    <TextView

                        android:id="@+id/todayMusclePart"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"
                        android:text="muscle"
                        android:textColor="@color/white"

                        android:textSize="20sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/noWorkoutValuesText"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_gravity="bottom"

        android:layout_marginBottom="80sp"

        android:orientation="vertical"

        android:visibility="invisible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="No Workout Values Yet!"
            android:textAlignment="center"
            android:textColor="@color/discord_blue"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="You can add new values on workout button"
            android:textAlignment="center"
            android:textColor="@color/discord_color3"
            android:textSize="15sp"
            android:textStyle="normal" />

    </LinearLayout>

</FrameLayout>